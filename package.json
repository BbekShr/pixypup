{
  "name": "pixypup",
  "version": "0.1.0",
  "description": "PixyPup: a desktop pet for macOS that walks on a transparent overlay.",
  "type": "module",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:pakkun": "PIXY_PACK_DIR=out/pack/Pakkun electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "pose-test": "tsx scripts/pose-test.ts",
    "build-native": "bash scripts/build-native.sh",
    "dist": "npm run build-native && npm run build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "dev.pixypup.app",
    "productName": "PixyPup",
    "files": [
      "dist/**/*",
      "assets/pets/**/*",
      "assets/placeholder/**/*",
      "package.json"
    ],
    "mac": {
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "PixyPup listens only while you press ⌥ Space so your pet can hear its name and a trick."
      },
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "extraResources": [
      {
        "from": "native/bin/pixyhelper",
        "to": "pixyhelper"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "sharp": "^0.35.5"
  }
}
