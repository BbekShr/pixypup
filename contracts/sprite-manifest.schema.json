{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixypup.dev/contracts/sprite-manifest.schema.json",
  "title": "SpriteManifest",
  "type": "object",
  "required": ["pet", "species", "poses"],
  "additionalProperties": false,
  "$defs": {
    "role": {
      "type": "object",
      "required": ["label", "prompt"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 16 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 200 },
        "bubble": { "type": "string", "minLength": 1, "maxLength": 12 }
      }
    },
    "motionProfile": {
      "type": "object",
      "required": ["locomotion", "subject", "styleHints", "gait", "cycle", "idlePrompt", "fidgets", "roles", "energy"],
      "additionalProperties": false,
      "properties": {
        "locomotion": { "enum": ["quadruped", "biped", "hop", "fly", "slither", "roll"] },
        "subject": { "type": "string", "minLength": 1, "maxLength": 60 },
        "styleHints": { "type": "string", "minLength": 1, "maxLength": 120 },
        "gait": {
          "type": "object",
          "required": ["cadenceHz", "strideBody", "bounce", "pitchDeg", "speedBody"],
          "additionalProperties": false,
          "properties": {
            "cadenceHz": { "type": "number", "minimum": 0.5, "maximum": 8 },
            "strideBody": { "type": "number", "minimum": 0.1, "maximum": 4 },
            "bounce": { "type": "number", "minimum": 0, "maximum": 0.3 },
            "pitchDeg": { "type": "number", "minimum": 0, "maximum": 25 },
            "speedBody": { "type": "number", "minimum": 0.05, "maximum": 5 }
          }
        },
        "air": {
          "type": "object",
          "required": ["minLiftBody", "maxLiftBody", "flutterHz", "perches", "sway"],
          "additionalProperties": false,
          "properties": {
            "minLiftBody": { "type": "number", "minimum": 0, "maximum": 6 },
            "maxLiftBody": { "type": "number", "minimum": 0.5, "maximum": 10 },
            "flutterHz": { "type": "number", "minimum": 1, "maximum": 40 },
            "perches": { "type": "boolean" },
            "sway": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "cycle": {
          "type": "object",
          "required": ["kind", "prompt"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["walk", "flap", "hop", "undulate", "spin"] },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 900 }
          }
        },
        "idlePrompt": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fidgets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "enum": ["groom", "knead", "flutter", "wave", "phone", "preen", "hover", "bob"] }
        },
        "roles": {
          "type": "object",
          "required": ["rest", "sleep", "voice", "trick"],
          "additionalProperties": false,
          "properties": {
            "rest": { "$ref": "#/$defs/role" },
            "sleep": { "$ref": "#/$defs/role" },
            "voice": { "$ref": "#/$defs/role" },
            "trick": { "$ref": "#/$defs/role" }
          }
        },
        "energy": { "type": "string", "minLength": 1, "maxLength": 40 }
      },
      "if": { "properties": { "locomotion": { "const": "fly" } } },
      "then": { "required": ["air"] }
    }
  },
  "properties": {
    "pet": { "type": "string" },
    "species": { "type": "string", "pattern": "^[A-Za-z][A-Za-z -]{0,29}$" },
    "profile": { "$ref": "#/$defs/motionProfile" },
    "personality": {
      "type": "object",
      "required": ["breed", "coat", "traits", "energy", "lines"],
      "additionalProperties": false,
      "properties": {
        "breed": { "type": "string", "maxLength": 60 },
        "coat": { "type": "string", "maxLength": 80 },
        "traits": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "maxLength": 30 } },
        "energy": { "enum": ["sleepy", "normal", "playful"] },
        "lines": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string", "maxLength": 40 } },
        "facts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "maxLength": 90 },
              "source": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    },
    "poses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["frames", "fps", "footY"],
        "additionalProperties": false,
        "properties": {
          "frames": { "type": "array", "items": { "type": "string" } },
          "fps": { "type": "number" },
          "footY": {
            "type": "number",
            "description": "Fraction (0..1) of the frame height, from the top, where the paws touch the floor."
          }
        }
      }
    }
  }
}
